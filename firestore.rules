rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to get user role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Function to check if user is an owner
    function isOwner() {
      return request.auth != null && getUserRole(request.auth.uid) == 'Owner';
    }

    // Function to check if user is an instructor
    function isInstructor() {
      return request.auth != null && getUserRole(request.auth.uid) == 'Instructor';
    }

    // Global deny by default (more specific rules will override)
    match /{document=**} {
      allow read, write: if false;
    }

    // Owners have full read/write access to all collections
    match /{collection}/{document} {
      allow read, write: if isOwner();
    }
    
    // Rules for 'users' collection
    match /users/{userId} {
      // Users can read their own profile, Owners can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
      // Users can create their own profile upon signup, Owners can create/update any profile
      allow create: if request.auth != null;
      // Owners can update any user's profile
      allow update: if isOwner();
      // Only owners can delete user profiles
      allow delete: if isOwner();
    }

    // Rules for 'enrollments' (ActiveClasses and History)
    match /enrollments/{enrollmentId} {
      // Owners and Instructors can read enrollments
      allow read: if isOwner() || isInstructor();
      // Only Owners can create or update enrollments, and 'price' must be a number
      allow create, update: if isOwner() && request.resource.data.price is number;
      // Only Owners can delete enrollments
      allow delete: if isOwner();
    }

    // Rules for 'courses'
    match /courses/{courseId} {
      // Owners and Instructors can read courses
      allow read: if isOwner() || isInstructor();
      // Only Owners can create, update, or delete courses
      allow create, update, delete: if isOwner();
    }

    // Additional rules for other collections can go here if needed.
    // For example, if you have a 'settings' collection that only owners can access:
    // match /settings/{document} {
    //   allow read, write: if isOwner();
    // }
  }
}
